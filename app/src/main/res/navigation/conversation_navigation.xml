<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversations_graph"
    app:startDestination="@id/listConversationFragment">
    <fragment
        android:id="@+id/listConversationFragment"
        android:name="com.rikkeisoft.awesome.ui.conversation.ListConversationFragment"
        android:label="ListConversationFragment"
        tools:layout="@layout/fragment_list_conversation">
        <action
            android:id="@+id/action_listConversationFragment_to_chatFragment"
            app:destination="@id/chatFragment"

            />
    </fragment>
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.rikkeisoft.awesome.ui.chat.ChatFragment"
        android:label="ChatFragment"
        tools:layout="@layout/fragment_chat" />

</navigation>