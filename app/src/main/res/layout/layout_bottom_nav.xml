<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_bottom_nav">

        <androidx.cardview.widget.CardView
            android:id="@+id/bg_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_margin="12dp"
            android:elevation="8dp"
            app:background="@color/white"
            app:cardCornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/indicator_conversation"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:elevation="12dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/bg_bottom_nav"
            app:layout_constraintEnd_toEndOf="@+id/btn_conversation"
            app:layout_constraintStart_toStartOf="@id/btn_conversation"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav" />

        <View
            android:id="@+id/indicator_friends"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:elevation="12dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/bg_bottom_nav"
            app:layout_constraintEnd_toEndOf="@+id/btn_friends"
            app:layout_constraintStart_toStartOf="@id/btn_friends"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav" />

        <View
            android:id="@+id/indicator_profile"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:elevation="12dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/bg_bottom_nav"
            app:layout_constraintEnd_toEndOf="@id/btn_profile"
            app:layout_constraintStart_toStartOf="@+id/btn_profile"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav" />

        <LinearLayout
            android:id="@+id/btn_conversation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="@id/bg_bottom_nav"
            app:layout_constraintEnd_toStartOf="@+id/btn_friends"
            app:layout_constraintStart_toStartOf="@+id/bg_bottom_nav"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_conversation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@drawable/bg_item_bottom_nav"
                android:src="@drawable/ic_conversation" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_conversation"
                style="@style/BottomNavTextActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_friends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="@id/bg_bottom_nav"
            app:layout_constraintEnd_toStartOf="@+id/btn_profile"
            app:layout_constraintStart_toEndOf="@+id/btn_conversation"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_friends"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_friends"
                app:tint="@color/gray" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_friends"
                style="@style/BottomNavTextInactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friends" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg_bottom_nav"
            app:layout_constraintEnd_toEndOf="@+id/bg_bottom_nav"
            app:layout_constraintStart_toEndOf="@+id/btn_friends"
            app:layout_constraintTop_toTopOf="@id/bg_bottom_nav">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_profile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/gray" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_profile"
                style="@style/BottomNavTextInactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>